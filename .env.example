# Configuración del entorno
NODE_ENV=development

# Servidor
PORT=3000

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=evento_db
DB_USER=root
DB_PASS=your_database_password_here

# JWT
JWT_SECRET=your_super_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# Email SMTP (configurar según tu proveedor)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=eventosturismo@promperu.gob.pe
SMTP_REMITE=PROMPERÚ Eventos

# URLs
BASE_URL=http://localhost:3000

# Admin (configurable - puede ser用户名 o correo electrónico)
ADMIN_USER=admin@promperu.gob.pe
ADMIN_PASS=f3ba77850afe6cefedf78d146afbbd03

# Variables de compatibilidad (mantener para no romper código existente)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@stringnet.pe
